# Copy this file to .env and replace every example value.
# Use only a website and account you are authorized to test.
BASE_URL=https://authorized.example/login
USERNAME=your-test-user
PASSWORD=replace-with-test-account-password

# Update selectors to match the authorized site's login page.
USERNAME_SELECTOR=input[name="username"]
PASSWORD_SELECTOR=input[name="password"]
LOGIN_BUTTON_SELECTOR=button[type="submit"]
SUCCESS_SELECTOR=[data-testid="login-success"]
FAILURE_SELECTOR=[data-testid="login-error"]

# Set to the site's CAPTCHA input selector to enable manual CAPTCHA entry.
# Leave blank when CAPTCHA is not present or an official test configuration disables it.
CAPTCHA_SELECTOR=

# Manual CAPTCHA entry requires a visible browser and an interactive terminal.
HEADLESS=false
BROWSER=chromium
TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=60000
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1
EXPECTED_LOGIN_SUCCESS=true

# ---------------------------------------------------------------------------
# Vehicle scraper — Navigation
# ---------------------------------------------------------------------------
# After the first successful run the logs will print a TIP with the form URL.
# Copy that URL here to skip navigation scanning on every future run.
VEHICLE_DETAILS_URL=

# ---------------------------------------------------------------------------
# Vehicle scraper — Vehicle Details
# ---------------------------------------------------------------------------
# VEH_REG_NUMBER=              # Existing: MH12AB1234 | New vehicle: leave blank or RTO code e.g. TN51
# VEH_RTO_LOCATION=            # e.g. Chennai Central  or  MH12-Pune
# VEH_MFG_YEAR=2026
# VEH_MFG_MONTH=February
# VEH_PURCHASE_DATE=           # DD-MM-YYYY e.g. 20-11-2026
# VEH_POLICY_START_DATE=       # DD-MM-YYYY (defaults to today)
# VEH_MAKE_MODEL_VARIANT=      # Typed into autocomplete, e.g. TVS JUPITER
# VEH_IDV=                     # e.g. 95000
# VEH_FUEL_TYPE=Petrol         # Petrol / Diesel / CNG / Electric
# VEH_BUSINESS_TYPE=New        # New / Renewal
# VEH_CUSTOMER_TYPE=Individual
# VEH_NCB=None                 # None / 20% / 25% / 35% / 45% / 50%
# VEH_DISCOUNT=0
# VEH_IS_NEW_VEHICLE=true      # true = check "New Vehicle" checkbox

# # ---------------------------------------------------------------------------
# # Vehicle scraper — Customer Details (Proposal form)
# # ---------------------------------------------------------------------------
# CUST_FIRST_NAME=
# CUST_MIDDLE_NAME=
# CUST_LAST_NAME=
# CUST_DOB=                    # DD-MM-YYYY e.g. 01-01-1990
# CUST_PAN=                    # e.g. ABCDE1234F
# CUST_GENDER=Male             # Male / Female / Other
# CUST_OCCUPATION=Others
# CUST_MARITAL_STATUS=Single   # Single / Married / Divorced / Widowed
# CUST_MOBILE=                 # 10-digit mobile
# CUST_EMAIL=
# CUST_AADHAR=                 # 12-digit Aadhar
# CUST_NATIONALITY=Indian
# CUST_GST=No                  # Registered under GST: Yes / No
# CUST_RELATED_PARTY=No

# # ---------------------------------------------------------------------------
# # Vehicle scraper — Communication / Permanent Address
# # ---------------------------------------------------------------------------
# CUST_FLAT=                   # Flat/Door No
# CUST_BUILDING=               # Name of Premises/Building
# CUST_STREET=                 # Road/Street/Area
# CUST_LANDMARK=
# CUST_PINCODE=                # 6-digit PIN
# CUST_STATE=                  # State name as shown in dropdown
# CUST_CITY=                   # Town/City as shown in dropdown
# CUST_PERM_SAME_AS_COMM=true  # true = tick "Permanent Address same as Communication"
