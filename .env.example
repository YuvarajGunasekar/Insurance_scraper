# Copy this file to .env and replace every example value.
# Use only a website and account you are authorized to test.
BASE_URL=https://authorized.example/login
USERNAME=your-authorized-username
PASSWORD=replace-with-test-account-password

# Scraping API configuration. Keep API_ALLOWED_HOSTS aligned with BASE_URL.
SCRAPER_CALLABLE=scrapers.vehicle_scraper:scrape_vehicle_coverage
API_ALLOWED_HOSTS=authorized.example

# Update selectors to match the authorized site's login page.
USERNAME_SELECTOR=input[name="username"]
PASSWORD_SELECTOR=input[name="password"]
LOGIN_BUTTON_SELECTOR=button[type="submit"]
SUCCESS_SELECTOR=[data-testid="login-success"]
FAILURE_SELECTOR=[data-testid="login-error"]

# Set to the site's CAPTCHA input selector to enable manual CAPTCHA entry.
# Leave blank when CAPTCHA is not present or an official test configuration disables it.
CAPTCHA_SELECTOR=

# Manual CAPTCHA entry requires a visible browser and an interactive terminal.
HEADLESS=false
BROWSER=chromium
TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=60000
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1
EXPECTED_LOGIN_SUCCESS=true

# ---------------------------------------------------------------------------
# Vehicle scraper — Navigation
# ---------------------------------------------------------------------------
# After the first successful run the logs will print a TIP with the form URL.
# Copy that URL here to skip navigation scanning on every future run.
VEHICLE_DETAILS_URL=

# Insurance, vehicle, cover, customer, nominee, address, document, and proposal
# action inputs are read from the active database row, not from .env.
